# Copy to .env before running docker compose up / the loader script / dbt.
# Local-only dev defaults — not production secrets.

POSTGRES_DB=warehouse
POSTGRES_USER=dbt_user
POSTGRES_PASSWORD=dbt_pass
POSTGRES_PORT=5434
POSTGRES_HOST=localhost

# Which month of NYC TLC data the loader script pulls in.
TAXI_YEAR=2024
TAXI_MONTH=1
