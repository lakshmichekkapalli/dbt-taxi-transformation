# Copy to dbt_project/profiles.yml (gitignored — never commit real credentials)
# or to ~/.dbt/profiles.yml, and fill in values matching your .env.

taxi_transformation:
  target: dev
  outputs:
    dev:
      type: postgres
      host: localhost
      port: 5434
      user: dbt_user
      password: dbt_pass
      dbname: warehouse
      schema: public
      threads: 4
